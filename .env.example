# ==============================================================================
# ShopPilot SaaS — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development or deploy environment configuration.
# NEVER commit your real `.env` file with production secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Debug Mode
# ------------------------------------------------------------------------------
# Set ENVIRONMENT to 'development' or 'production'
ENVIRONMENT=development
# Set to 'False' in production. If ENVIRONMENT=production, DEBUG=True is strictly rejected.
DJANGO_DEBUG=True
# Alias supported: DEBUG=True

# ------------------------------------------------------------------------------
# 2. Security & Secret Keys
# ------------------------------------------------------------------------------
# In production (DEBUG=False), DJANGO_SECRET_KEY must be at least 32 characters long.
# Generate a strong key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=dev-shoppilot-insecure-key-1234567890-change-in-production

# Comma-separated list of allowed hostnames. Wildcards ('*') are strictly rejected in production.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
# Alias supported: ALLOWED_HOSTS=...

# ------------------------------------------------------------------------------
# 3. Reverse Proxy & HTTPS Security Headers
# ------------------------------------------------------------------------------
# Set BEHIND_REVERSE_PROXY=True ONLY if your deployment is behind a trusted reverse proxy (Nginx, Traefik, Caddy, Cloudflare).
# If False, HTTP_X_FORWARDED_PROTO will not be blindly trusted.
BEHIND_REVERSE_PROXY=False

# Enable SSL redirection and HSTS in production with HTTPS
SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000

# Comma-separated list of trusted origins for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. Database Configuration
# ------------------------------------------------------------------------------
# You can use DATABASE_URL (PostgreSQL scheme required in production)
# Example: DATABASE_URL=postgres://shoppilot_user:shoppilot_password@localhost:5432/shoppilot
# Or individual DB_* parameters:
DB_NAME=shoppilot
DB_USER=shoppilot_user
DB_PASSWORD=shoppilot_password
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
# ALLOW_SQLITE_IN_PRODUCTION=False

# ------------------------------------------------------------------------------
# 5. Redis & Celery Asynchronous Workers
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 6. CORS Configuration
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 7. External Integrations (Optional / Provider Specific)
# ------------------------------------------------------------------------------
# Google Gemini AI API (Passed securely via x-goog-api-key header)
# GEMINI_API_KEY=your_gemini_api_key_here

# Kavenegar SMS Gateway
# KAVENEGAR_API_KEY=your_kavenegar_api_key_here

# Zarinpal Payment Gateway
# In production, set your 36-character live Merchant ID.
# Set ZARINPAL_SANDBOX=False for real bank transactions, or True for test sandbox.
# ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# ZARINPAL_SANDBOX=False
# To enable automated gateway refunds, provide the commercial Zarinpal API Access Token (Bearer Token):
# ZARINPAL_ACCESS_TOKEN=your_zarinpal_api_access_token_for_refunds

# ------------------------------------------------------------------------------
# 8. Demo & Seed Data Configuration
# ------------------------------------------------------------------------------
# Default password for seed_demo_data command (never executed in production without --allow-production)
DEMO_USER_PASSWORD=password123

# ------------------------------------------------------------------------------
# 9. Frontend (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
